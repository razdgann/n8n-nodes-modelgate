{
	"name": "n8n-nodes-modelgate",
	"version": "0.1.0",
	"description": "n8n community node for ModelGate — call any LLM through the ModelGate gateway with automatic cost, token and usage tracking.",
	"license": "MIT",
	"homepage": "https://modelgatehq.com",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"modelgate",
		"llm",
		"ai",
		"openai",
		"anthropic",
		"gateway"
	],
	"author": {
		"name": "ModelGate",
		"email": "support@modelgatehq.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/razdgann/n8n-nodes-modelgate.git"
	},
	"bugs": {
		"url": "https://github.com/razdgann/n8n-nodes-modelgate/issues"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"format": "prettier nodes credentials --write",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:e2e": "jest --config jest.e2e.config.js",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [
			"dist/credentials/ModelGateApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ModelGate/ModelGate.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.46.1",
		"@types/jest": "^29.5.14",
		"@types/node": "^20.19.0",
		"eslint": "9.29.0",
		"jest": "^29.7.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"ts-jest": "^29.2.5",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
